# Hosted Otari (otari.ai). Use a SERVICE key: Keys > Create key > Advanced > Service key.
OTARI_API_KEY=otk_...
# US accounts: https://api.otari.ai/api/v1   EU accounts: https://eu.api.otari.ai/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1

# Public https URL of this app, so Otari's cloud can reach the MCP server and the guardrail service.
# On Render this is set for you (RENDER_EXTERNAL_URL); locally use a tunnel, e.g. cloudflared.
PUBLIC_URL=
# Long random strings (python -c "import secrets; print(secrets.token_urlsafe(24))").
MCP_TOKEN=
GUARD_TOKEN=
# Optional: id of the MCP server registered under Tools > MCP servers (else it is sent inline per request).
OTARI_MCP_SERVER_ID=

# Model roles (catalog ids or routing-policy names). Defaults are in wildpatch/config.py.
# MODEL_PLANNER=wildpatch-planner
# PLANNER_ECONOMY_MODEL=alibaba/qwen3.6-35b-a3b
# PLANNER_DRILL_POLICY=wildpatch-drill

# Per-volunteer budgets (labels for the meter; Otari enforces the real ones).
GUEST_BUDGET_ID=wildpatch-guest
VOLUNTEER_CAP_USD=0.50
GUEST_CAP_USD=0.02
